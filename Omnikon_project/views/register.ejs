<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full h-full bg-zinc-900">
    <div class="p-20 text-white">
        <form action="/create" method="post">
            <input type="text" class="w-75 h-15 px-3 py-2 mt-3 rounded-md bg-zinc-800 placeholder:text-zinc-500 outline-none" placeholder="Subhasish Tripathy" name="name"><br>
            <input type="email" class=" w-75 h-15 px-3 py-2 mt-3 rounded-md bg-zinc-800 placeholder:text-zinc-500 outline-none" placeholder="abc@gmail.com" name="email"><br>
            <input type="password" class="w-75 h-15 px-3 py-2 mt-3 rounded-md bg-zinc-800 placeholder:text-zinc-500 outline-none" placeholder="shhhhh!" name="password"><br>
            <input type="submit" class="bg-blue-500 text-white mt-3 px-3 py-2" value="submit">
        </form>
    </div>
</body>
</html>